diff --git a/crates/launcher/src/pipe.rs b/crates/launcher/src/pipe.rs
new file mode 100644
index 0000000..b522e5d
--- /dev/null
+++ b/crates/launcher/src/pipe.rs
@@ -0,0 +1,99 @@
+//! Input from a frontend that reads the devices itself (`--input-pipe`).
+//!
+//! The frontend writes one line per change on standard input:
+//!
+//! ```text
+//! p<player> <buttons hex> <lx> <ly> <rx> <ry> <accel> <brake>
+//! quit
+//! ```
+//!
+//! buttons are the virtual stick's bits ([`wal_protocol::button`]), axes -32768..=32767
+//! (pedals 0..=32767). The latest line of each player is its whole state. `quit` (or the end of
+//! standard input) asks the launcher to stop the game. The game's outputs (force feedback,
+//! lamps) are written to standard output as `out <player> <id> <value>` lines.
+
+use std::io::{BufRead, Write};
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex};
+
+use wal_protocol::{InputFrame, MAX_PLAYERS, Output, StickState};
+
+pub struct Pipe {
+    frame: Arc<Mutex<InputFrame>>,
+    quit: Arc<AtomicBool>,
+}
+
+/// One input line: the player index (0-based) and its state, or `None` for `quit`.
+pub fn parse(line: &str) -> Result<Option<(usize, StickState)>, String> {
+    let mut words = line.split_whitespace();
+    let first = words.next().ok_or("empty line")?;
+    if first == "quit" {
+        return Ok(None);
+    }
+    let player: usize = first
+        .strip_prefix('p')
+        .and_then(|p| p.parse().ok())
+        .filter(|p| (1..=MAX_PLAYERS).contains(p))
+        .ok_or_else(|| format!("bad player {first:?}"))?;
+    let buttons = words
+        .next()
+        .and_then(|b| u32::from_str_radix(b.trim_start_matches("0x"), 16).ok())
+        .ok_or("bad buttons")?;
+    let mut stick = StickState { buttons, ..StickState::default() };
+    for axis in stick.axes.iter_mut() {
+        *axis = words.next().and_then(|v| v.parse().ok()).ok_or("missing axis")?;
+    }
+    Ok(Some((player - 1, stick)))
+}
+
+impl Pipe {
+    /// Reads standard input on its own thread.
+    pub fn start() -> Pipe {
+        let frame = Arc::new(Mutex::new(InputFrame::default()));
+        let quit = Arc::new(AtomicBool::new(false));
+        let (f, q) = (frame.clone(), quit.clone());
+        std::thread::spawn(move || {
+            for line in std::io::stdin().lock().lines() {
+                let Ok(line) = line else { break };
+                match parse(&line) {
+                    Ok(Some((p, stick))) => f.lock().unwrap().players[p] = stick,
+                    Ok(None) => break,
+                    Err(e) => eprintln!("pipe: {e}: {line:?}"),
+                }
+            }
+            q.store(true, Ordering::SeqCst);
+        });
+        Pipe { frame, quit }
+    }
+
+    pub fn frame(&self) -> InputFrame {
+        self.frame.lock().unwrap().clone()
+    }
+
+    pub fn quit_requested(&self) -> bool {
+        self.quit.load(Ordering::SeqCst)
+    }
+
+    pub fn output(o: &Output) {
+        let mut out = std::io::stdout().lock();
+        let _ = writeln!(out, "out {} {} {}", o.player, o.id, o.value);
+        let _ = out.flush();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn parses_a_state_line_and_quit() {
+        let (p, s) = parse("p2 1010 -32768 0 5 -5 32767 0").unwrap().unwrap();
+        assert_eq!(p, 1);
+        assert_eq!(s.buttons, 0x1010);
+        assert_eq!(s.axes, [-32768, 0, 5, -5, 32767, 0]);
+        assert_eq!(parse("quit").unwrap(), None);
+        assert!(parse("p9 0 0 0 0 0 0 0").is_err());
+        assert!(parse("p1 zz 0 0 0 0 0 0").is_err());
+        assert!(parse("p1 0 0 0").is_err());
+    }
+}
