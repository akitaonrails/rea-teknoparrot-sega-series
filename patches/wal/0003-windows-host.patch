+++ b/crates/winhost/src/native.rs
@@ -0,0 +1,195 @@
+//! What Wine's prefix does for the Linux launcher, done on Windows itself: the cabinet's drive
+//! letters, the folders of C: a game reaches by absolute paths, and ending every process of the
+//! game.
+
+use std::collections::BTreeMap;
+use std::path::{Component, Path, PathBuf};
+
+use anyhow::{Context, Result, bail};
+
+fn wide(s: &str) -> Vec<u16> {
+    s.encode_utf16().chain([0]).collect()
+}
+
+/// A plain Windows path for the system calls (no `\\?\` prefix).
+fn plain(p: &Path) -> String {
+    let s = p.display().to_string();
+    s.strip_prefix(r"\\?\").map(str::to_string).unwrap_or(s)
+}
+
+/// The cabinet's drive letters (profile `drives`: `e: amfs`), each a folder of the dump, defined
+/// for this logon session with `DefineDosDevice` (as `subst` does) for the time of the game. A
+/// letter the computer already uses is shadowed meanwhile (the session's definition goes
+/// first), and given back when the game ends.
+pub struct Drives {
+    defined: Vec<(String, String)>,
+}
+
+impl Drives {
+    pub fn map(drives: &BTreeMap<String, PathBuf>, root: &Path) -> Result<Drives> {
+        let mut defined = Vec::new();
+        for (letter, directory) in drives {
+            let letter = letter.trim_end_matches(':').to_ascii_uppercase();
+            if letter.len() != 1 || !letter.as_bytes()[0].is_ascii_alphabetic() || matches!(letter.as_str(), "C" | "Z") {
+                bail!("invalid cabinet drive {letter:?}: use a letter other than C or Z");
+            }
+            if directory.as_os_str().is_empty() || directory.components().any(|c| !matches!(c, Component::Normal(_))) {
+                bail!("drive {letter}: directory must be relative to the dump root: {}", directory.display());
+            }
+            let target = root.join(directory);
+            std::fs::create_dir_all(&target).with_context(|| format!("creating drive {letter}: directory {}", target.display()))?;
+            let target = plain(&std::path::absolute(&target)?);
+            let device = format!("{letter}:");
+            // a definition a previous run left (the launcher ended without its cleanup)
+            while remove(&device, &target) {}
+            if unsafe { windows_sys::Win32::Storage::FileSystem::DefineDosDeviceW(0, wide(&device).as_ptr(), wide(&target).as_ptr()) } == 0 {
+                bail!("mapping drive {device} to {target}: {}", std::io::Error::last_os_error());
+            }
+            eprintln!("winhost: drive {device} -> {target}");
+            defined.push((device, target));
+        }
+        Ok(Drives { defined })
+    }
+}
+
+fn remove(device: &str, target: &str) -> bool {
+    use windows_sys::Win32::Storage::FileSystem::{DDD_EXACT_MATCH_ON_REMOVE, DDD_REMOVE_DEFINITION, DefineDosDeviceW};
+    unsafe { DefineDosDeviceW(DDD_REMOVE_DEFINITION | DDD_EXACT_MATCH_ON_REMOVE, wide(device).as_ptr(), wide(target).as_ptr()) != 0 }
+}
+
+impl Drop for Drives {
+    fn drop(&mut self) {
+        for (device, target) in self.defined.drain(..).rev() {
+            if remove(&device, &target) {
+                eprintln!("winhost: drive {device} given back");
+            } else {
+                eprintln!("winhost: drive {device} could not be given back: {}", std::io::Error::last_os_error());
+            }
+        }
+    }
+}
+
+/// Folders of drive C: a game reaches by absolute paths (profile `c_folders`:
+/// `Mount/Option: Option`), junctions to folders of its run directory for the time of the game.
+/// A folder the dump does not have is made in the dump (`root`), as on Linux.
+pub struct CFolders {
+    made: Vec<PathBuf>,
+}
+
+impl CFolders {
+    pub fn map(folders: &BTreeMap<String, PathBuf>, run_dir: &Path, root: &Path) -> CFolders {
+        let mut made = Vec::new();
+        for (name, directory) in folders {
+            let target = run_dir.join(directory);
+            if !target.exists() {
+                let dump = root.join(directory);
+                if let Err(e) = std::fs::create_dir_all(&dump) {
+                    eprintln!("winhost: C:\\{name}: creating {}: {e}", dump.display());
+                    continue;
+                }
+                if std::fs::symlink_metadata(&target).is_err() {
+                    let _ = junction::create(&dump, &target);
+                }
+            }
+            let at = Path::new(r"C:\").join(name);
+            match std::fs::symlink_metadata(&at) {
+                // a folder of the computer itself: never touched
+                Ok(m) if !m.file_type().is_symlink() => {
+                    eprintln!("winhost: C:\\{name} exists on this computer: left as it is");
+                    continue;
+                }
+                Ok(_) => {
+                    let _ = std::fs::remove_dir(&at);
+                }
+                Err(_) => {}
+            }
+            let made_parent = at.parent().is_some_and(|p| std::fs::create_dir_all(p).is_ok());
+            match junction::create(&target, &at) {
+                Ok(()) => {
+                    eprintln!("winhost: C:\\{name} -> {}", target.display());
+                    made.push(at);
+                }
+                // optional data (the attract's information movie): the game runs without it
+                Err(e) => eprintln!("winhost: C:\\{name} not linked ({e}{})", if made_parent { "" } else { ", its parent folder could not be made" }),
+            }
+        }
+        CFolders { made }
+    }
+}
+
+impl Drop for CFolders {
+    fn drop(&mut self) {
+        for at in self.made.drain(..) {
+            let _ = std::fs::remove_dir(&at);
+        }
+    }
+}
