+version.workspace = true
+
+[[bin]]
+name = "arcade-launcher"
+path = "src/main.rs"
+
+[dependencies]
+wal-protocol = { path = "../protocol" }
+anyhow = "1"
+serde = { version = "1", features = ["derive"] }
+serde_yaml_ng = "0.10"
+
+[target.'cfg(windows)'.dependencies]
+junction = "2"
+windows-sys = { version = "0.61", features = [
+    "Win32_Foundation",
+    "Win32_Security",
