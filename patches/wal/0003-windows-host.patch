+/// Every process the launcher starts is in this job, the launcher too (children inherit it):
+/// [`Job::end`] ends them all, the game's own children included (amdaemon, the store server).
+pub struct Job(windows_sys::Win32::Foundation::HANDLE);
+
+impl Job {
+    pub fn new() -> Result<Job> {
+        use windows_sys::Win32::System::JobObjects::*;
+        use windows_sys::Win32::System::Threading::GetCurrentProcess;
+        unsafe {
+            let job = CreateJobObjectW(std::ptr::null(), std::ptr::null());
+            if job.is_null() {
+                bail!("creating the job object: {}", std::io::Error::last_os_error());
+            }
+            let mut info: JOBOBJECT_EXTENDED_LIMIT_INFORMATION = std::mem::zeroed();
+            // the launcher killed: its game goes with it
+            info.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+            SetInformationJobObject(
+                job,
+                JobObjectExtendedLimitInformation,
+                &info as *const _ as *const std::ffi::c_void,
+                std::mem::size_of::<JOBOBJECT_EXTENDED_LIMIT_INFORMATION>() as u32,
+            );
+            if AssignProcessToJobObject(job, GetCurrentProcess()) == 0 {
+                bail!("joining the job object: {}", std::io::Error::last_os_error());
+            }
+            Ok(Job(job))
+        }
+    }
+
+    /// Ends every process of the job, the launcher included: its last call.
+    pub fn end(&self, code: u32) -> ! {
+        unsafe { windows_sys::Win32::System::JobObjects::TerminateJobObject(self.0, code) };
+        std::process::exit(code as i32)
+    }
+}
+
+/// The primary screen's size.
+pub fn screen_size() -> Option<(u32, u32)> {
+    use windows_sys::Win32::UI::WindowsAndMessaging::{GetSystemMetrics, SM_CXSCREEN, SM_CYSCREEN};
+    let (w, h) = unsafe { (GetSystemMetrics(SM_CXSCREEN), GetSystemMetrics(SM_CYSCREEN)) };
+    (w > 0 && h > 0).then_some((w as u32, h as u32))
+}
+
+/// Programs start without a console window of their own (amdaemon is a console program).
+pub const CREATE_NO_WINDOW: u32 = 0x0800_0000;
+
+/// The DLLs of a winetricks verb the game needs from Windows itself (`xact`: the DirectX
+/// End-User Runtime's XAudio2 and XACT), checked in the system folder of the game's
+/// architecture; what is missing is reported.
+pub fn check_tricks(tricks: &[String], game64: bool) {
+    let windir = std::env::var("SystemRoot").unwrap_or_else(|_| r"C:\Windows".into());
+    let system = Path::new(&windir).join(if game64 || !cfg!(target_pointer_width = "64") { "System32" } else { "SysWOW64" });
+    for verb in tricks {
+        let dlls: &[&str] = match verb.as_str() {
+            "xact" => &["xactengine3_7.dll", "xaudio2_7.dll", "x3daudio1_7.dll"],
+            "d3dx9" => &["d3dx9_43.dll"],
+            _ => continue,
+        };
+        let missing: Vec<&str> = dlls.iter().copied().filter(|d| !system.join(d).is_file()).collect();
+        if !missing.is_empty() {
+            eprintln!(
+                "winhost: {} missing from {} ({verb}): install Microsoft's DirectX End-User Runtime (June 2010)",
+                missing.join(", "),
+                system.display()
+            );
+        }
+    }
+}
