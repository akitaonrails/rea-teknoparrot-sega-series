+    "Win32_System_Threading",
+    "Win32_UI_WindowsAndMessaging",
+] }
diff --git a/crates/winhost/src/main.rs b/crates/winhost/src/main.rs
new file mode 100644
index 0000000..4826513
--- /dev/null
+++ b/crates/winhost/src/main.rs
@@ -0,0 +1,346 @@
+//! The launcher's `run` on Windows itself: the same profiles (system profiles, user layers,
+//! `--profile`), the same run directory (links: directory junctions and file copies), the same
+//! payloads through `wal-loader`, the same input server; what Wine's prefix did (the cabinet's
+//! drives, the folders of C:) is done with Windows' own calls ([`native`]).
+//!
+//! Input comes from a frontend that reads the devices itself (`--input-pipe`) or an input
+//! script; this build has no device reading of its own.
+
+#![cfg_attr(not(windows), allow(dead_code, unused_imports))]
+
+#[allow(dead_code)]
+#[path = "../../launcher/src/config.rs"]
+mod config;
+#[cfg(windows)]
+mod native;
+#[allow(dead_code)]
+#[path = "../../launcher/src/pipe.rs"]
+mod pipe;
+#[allow(dead_code)]
+#[path = "../../launcher/src/rundir.rs"]
+mod rundir;
+#[allow(dead_code)]
+#[path = "../../launcher/src/script.rs"]
+mod script;
+#[allow(dead_code)]
+#[path = "../../launcher/src/server.rs"]
+mod server;
+#[allow(dead_code)]
+#[path = "../../launcher/src/systems/mod.rs"]
+mod systems;
+
+use std::path::{Path, PathBuf};
+use std::process::Command;
+use std::time::{Duration, Instant};
+
+use anyhow::{Context, Result, bail};
+
+use config::Profile;
+use wal_protocol::{InputFrame, env};
+
+const USAGE: &str = "\
+usage: arcade-launcher [run] <dump> [--root DIR] [--profile FILE]... [--input-pipe]
+                       [--input-script FILE] [--dry-run]
+    Windows build: runs a game of a dump (a folder with a <gameid>.windowsloader file) with
+    its profile, fed by a frontend on standard input (--input-pipe) or a timed script.";
+
+struct Args {
+    dump: Option<String>,
+    root: Option<PathBuf>,
+    layers: Vec<PathBuf>,
+    dry_run: bool,
+    script: Option<PathBuf>,
+    input_pipe: bool,
+}
+
+fn parse_args() -> Result<Args> {
+    let mut args = Args { dump: None, root: None, layers: Vec::new(), dry_run: false, script: None, input_pipe: false };
+    let mut it = std::env::args().skip(1);
+    while let Some(a) = it.next() {
+        match a.as_str() {
+            "run" if args.dump.is_none() => {}
+            "--root" => args.root = Some(it.next().context("--root needs a directory")?.into()),
+            "--profile" => args.layers.push(it.next().context("--profile needs a file")?.into()),
+            "--dry-run" => args.dry_run = true,
+            "--input-pipe" => args.input_pipe = true,
+            "--no-input" | "--headless" => {}
+            "--input-script" => args.script = Some(it.next().context("--input-script needs a file")?.into()),
+            "-h" | "--help" => {
+                println!("{USAGE}");
+                std::process::exit(0);
+            }
+            _ if a.starts_with("--") => bail!("unknown option {a}\n{USAGE}"),
+            _ => args.dump = Some(a),
+        }
+    }
+    Ok(args)
+}
+
+fn main() {
+    if let Err(e) = real_main() {
+        eprintln!("error: {e:#}");
+        std::process::exit(1);
+    }
+}
+
+#[cfg(not(windows))]
+fn real_main() -> Result<()> {
+    bail!("this is the Windows build of the launcher")
+}
+
+#[cfg(windows)]
+fn real_main() -> Result<()> {
+    let args = parse_args()?;
+    let dump = args.dump.as_deref().with_context(|| format!("missing <dump>\n{USAGE}"))?;
+    let mut profile = Profile::load(dump, args.root.as_deref(), &args.layers)?;
+    // the Linux launcher's Wine path (`Z:` + the dump's path) as a Windows path
+    profile.exe = profile.exe.strip_prefix("Z:").unwrap_or(&profile.exe).to_string();
+    let script = args.script.as_deref().map(script::Script::load).transpose()?;
+    let job = native::Job::new()?;
+    let code = match run(&profile, &args, script) {
+        Ok(()) => 0,
+        Err(e) => {
+            eprintln!("error: {e:#}");
+            1
+        }
+    };
+    // the game's leftovers (amdaemon, the store server) end with the launcher
+    job.end(code)
+}
+
+/// The screen size placeholders of a profile value (`{screen_width}`...), as the Linux
+/// launcher fills them.
+fn screen_placeholders(arg: &str, (sw, sh): (u32, u32)) -> String {
+    arg.replace("{screen_width}", &sw.to_string()).replace("{screen_height}", &sh.to_string())
+}
+
+#[cfg(windows)]
+fn run(profile: &Profile, args: &Args, script: Option<script::Script>) -> Result<()> {
+    use std::os::windows::process::CommandExt;
+
+    if profile.exe.is_empty() {
+        bail!("{}: launch a game from its dump (directory or <gameid>.windowsloader file)", profile.id);
+    }
+    let system = systems::by_name(&profile.system)?;
+    let exe = PathBuf::from(&profile.exe);
+    if !exe.is_file() {
+        bail!("game executable not found: {}", exe.display());
+    }
+    let game_dir = exe.parent().context("executable without directory")?;
+    let exe_name = exe.file_name().context("executable without name")?;
+    let mut game_root = game_dir;
+    for _ in 0..profile.exe_depth {
+        game_root = game_root.parent().context("exe_depth goes above the filesystem root")?;
+    }
+    let exe_subdir = game_dir.strip_prefix(game_root)?.to_path_buf();
+    let game64 = rundir::is_pe64(&exe);
+
+    // the payloads, as the Linux launcher picks them
+    let payload_dir = profile.path(&profile.payloads_dir);
+    let system_payloads = match system.payloads64() {
+        Some(p) if game64 => p,
+        _ => system.payloads(),
+    };
+    let mut payloads: Vec<(PathBuf, String)> = match system_payloads.first() {
+        Some(p) if !profile.payload_install.is_empty() => {
+            profile.payload_install.iter().map(|path| (payload_dir.join(p.file), path.clone())).collect()
+        }
+        _ => system_payloads.iter().map(|p| (payload_dir.join(p.file), p.install_as.to_string())).collect(),
+    };
+    let loader = if system_payloads.is_empty() {
+        None
+    } else if profile.payload_loader {
+        payloads.first().map(|(_, at)| at.clone())
+    } else if game64 || !profile.payload_install.is_empty() {
+        None
+    } else {
+        system.loader().map(str::to_string)
+    };
+    if loader.is_some() {
+        let file = if game64 { "wal-loader64.exe" } else { "wal-loader.exe" };
+        payloads.push((payload_dir.join(file), "wal-loader.exe".into()));
+    }
+    for (src, _) in &payloads {
+        if !src.exists() {
+            bail!("payload {} missing", src.display());
+        }
+    }
+    for (name, src) in &profile.files {
+        let src = match src.strip_prefix("{dump}") {
+            Ok(rel) => game_root.join(rel),
+            Err(_) => match src.strip_prefix("{payloads}") {
+                Ok(file) => payload_dir.join(file),
+                Err(_) => profile.path(src),
+            },
+        };
+        if !src.is_file() {
+            bail!("profile file {} missing", src.display());
+        }
+        payloads.push((src, name.clone()));
+    }
+    native::check_tricks(&profile.prefix_tricks, game64);
+    native::check_tricks(&profile.tricks, game64);
+
+    let mut hide: Vec<String> = profile.hide.clone();
+    hide.extend(profile.reshade_files.iter().cloned());
+    hide.extend(system.hidden().iter().map(|s| s.to_string()));
+    let run_dir = profile.root.join("run").join(system.name()).join(profile.slug());
+    let payload_refs: Vec<(&Path, PathBuf)> = payloads
+        .iter()
+        .map(|(p, n)| {
+            let at = if n.contains(['/', '\\']) { n.split(['/', '\\']).filter(|c| !c.is_empty()).collect() } else { exe_subdir.join(n) };
+            (p.as_path(), at)
+        })
+        .collect();
+    for dir in system.data_dirs() {
+        std::fs::create_dir_all(game_dir.join(dir)).with_context(|| format!("creating {}", game_dir.join(dir).display()))?;
+    }
+    for (name, src) in &profile.initial_files {
+        let dst = game_root.join(name);
+        if !dst.exists() {
+            if let Some(dir) = dst.parent() {
+                std::fs::create_dir_all(dir)?;
+            }
+            let src = match src.strip_prefix("{dump}") {
+                Ok(rel) => game_root.join(rel),
+                Err(_) => profile.path(src),
+            };
+            std::fs::copy(&src, &dst).with_context(|| format!("initial file {} -> {}", src.display(), dst.display()))?;
+        }
+    }
+    if !args.dry_run {
+        rundir::build_tree(&run_dir, game_root, &hide, std::slice::from_ref(&exe_subdir), &payload_refs)?;
+        if profile.exe_fixed_base {
+            rundir::copy_fixed_base(&exe, &run_dir.join(&exe_subdir).join(exe_name))?;
+        } else if profile.large_address_aware {
+            rundir::copy_large_address_aware(&exe, &run_dir.join(&exe_subdir).join(exe_name))?;
+        }
+        for (file, sections) in &profile.readonly_sections {
+            rundir::readonly_sections(&game_root.join(file), &run_dir.join(file), sections)?;
+        }
+    }
+    let run_exe_dir = run_dir.join(&exe_subdir);
+    let (_drives, _c_folders) = if args.dry_run {
+        (None, None)
+    } else {
+        (
+            Some(native::Drives::map(&profile.drives, game_root)?),
+            Some(native::CFolders::map(&profile.c_folders, &run_dir, game_root)),
+        )
+    };
+    if !profile.run_drives.is_empty() || !profile.registry.is_empty() || !profile.fonts.is_empty() {
+        eprintln!("winhost: run_drives, registry and fonts of the profile are not applied on Windows");
+    }
+
+    let screen = native::screen_size().unwrap_or((1920, 1080));
+    let mut vars: Vec<(String, String)> = vec![
+        (env::PORT.into(), profile.port.to_string()),
+        (env::LOG.into(), run_dir.join(format!("wal-{}.log", system.name())).display().to_string()),
+        ("WAL_SINDEN_BORDER".into(), "0".into()),
+    ];
+    if !profile.native_map.is_empty() {
+        let map: Vec<String> = profile.native_map.iter().map(|(k, v)| format!("{k}={v}")).collect();
+        vars.push((env::MAP.into(), map.join(",")));
+    }
+    for (k, v) in &profile.env {
+        vars.push((k.clone(), screen_placeholders(v, screen)));
+    }
+    let screen_args = |a: &[String]| -> Vec<String> { a.iter().map(|x| screen_placeholders(x, screen)).collect() };
+    let command = |program: &Path, payload: Option<&str>, target: &Path, rest: &[String]| -> Command {
+        let mut cmd = match payload {
+            Some(p) => {
+                let mut c = Command::new(run_exe_dir.join("wal-loader.exe"));
+                let at = if p.contains(['/', '\\']) { run_dir.join(p) } else { run_exe_dir.join(p) };
+                c.arg(at).arg(target);
+                c
+            }
+            None => Command::new(program),
+        };
+        cmd.args(rest).current_dir(&run_exe_dir).envs(vars.iter().map(|(k, v)| (k, v))).creation_flags(native::CREATE_NO_WINDOW);
+        cmd
+    };
+    let game_exe = run_exe_dir.join(exe_name);
+    let game_command = |rest: &[String], relaunched: bool, other_exe: Option<&str>| -> Command {
+        let target = other_exe.map_or_else(|| game_exe.clone(), |e| run_exe_dir.join(e));
+        let mut cmd = command(&target, loader.as_deref(), &target, &screen_args(rest));
+        if relaunched {
+            cmd.env(env::RELAUNCH, "1");
+        }
+        cmd
+    };
+    eprintln!("game: {} ({})", profile.name.as_deref().unwrap_or(&profile.id), profile.id);
+    eprintln!("profile layers: {:?}", profile.sources);
+    eprintln!("run directory: {}", run_dir.display());
+    if args.dry_run {
+        for (k, v) in &vars {
+            println!("{k}={v}");
+        }
+        let cmd = game_command(&profile.args, false, None);
+        let argv: Vec<_> = std::iter::once(cmd.get_program()).chain(cmd.get_args()).collect();
+        println!("cd {:?} && {:?}", run_exe_dir, argv);
+        return Ok(());
+    }
+
+    let server = server::Server::start(profile.port)?;
+    // programs left running beside the game (amdaemon), through wal-loader with the payload
+    for program in &profile.background {
+        let words: Vec<String> = screen_args(&program.split(' ').filter(|w| !w.is_empty()).map(String::from).collect::<Vec<_>>());
+        let Some((first, rest)) = words.split_first() else { continue };
+        let target = run_exe_dir.join(first);
+        if loader.is_some() && rundir::is_pe64(&target) != game64 {
+            bail!("background program {first}: another architecture than the game's, not supported on Windows yet");
+        }
+        let mut cmd = command(&target, loader.as_deref(), &target, rest);
+        eprintln!("winhost: starting background program {first}");
+        cmd.stdin(std::process::Stdio::null()).spawn().with_context(|| format!("starting background program {first}"))?;
+    }
+    let mut cmd = game_command(&profile.args, false, None);
+    if !profile.background.is_empty() {
+        std::thread::sleep(Duration::from_millis(profile.background_wait_ms));
+        cmd.env("WAL_LOG_APPEND", "1");
+    }
+    let mut child = cmd.stdin(std::process::Stdio::null()).spawn().context("starting the game")?;
+
+    let pipe = args.input_pipe.then(pipe::Pipe::start);
+    let mut last = InputFrame::default();
+    let mut last_sent = Instant::now();
+    let status = loop {
+        std::thread::sleep(Duration::from_millis(4));
+        let mut frame = pipe.as_ref().map(pipe::Pipe::frame).unwrap_or_default();
+        if let Some(s) = &script {
+            for (p, stick) in frame.players.iter_mut().enumerate() {
+                s.apply(p, stick);
+            }
+        }
+        for o in server.outputs() {
+            if pipe.is_some() {
+                pipe::Pipe::output(&o);
+            }
+        }
+        if frame != last || last_sent.elapsed() > Duration::from_millis(100) {
+            server.broadcast(&frame);
+            last = frame;
+            last_sent = Instant::now();
+        }
+        if pipe.as_ref().is_some_and(pipe::Pipe::quit_requested) {
+            eprintln!("winhost: stopping the game");
+            let _ = child.kill();
+            break child.wait()?;
+        }
+        if let Some(status) = child.try_wait()? {
+            if let Some(again) = server.take_relaunch() {
+                eprintln!("winhost: game exited ({status}), started again: {again}");
+                let words: Vec<&str> = again.split(' ').filter(|a| !a.is_empty()).collect();
+                let (other, rest): (Option<&str>, Vec<String>) = match words.first().and_then(|w| w.strip_prefix("exe=")) {
+                    Some(e) => (Some(e), words[1..].iter().map(|a| a.to_string()).collect()),
+                    None => (None, profile.args.iter().cloned().chain(words.iter().map(|a| a.to_string())).collect()),
+                };
+                child = game_command(&rest, true, other).stdin(std::process::Stdio::null()).spawn().context("starting the game again")?;
+                continue;
+            }
+            break status;
+        }
+    };
+    eprintln!("winhost: game exited ({status})");
+    Ok(())
+}
