+/// A link `dst` to the game's `src`.
+#[cfg(unix)]
+fn link(src: &Path, dst: &Path) -> std::io::Result<()> {
+    std::os::unix::fs::symlink(src, dst)
+}
+
+/// Windows (no symlinks without administrator rights or developer mode): a folder is a
+/// directory junction (a directory symlink for a folder on a network share, which a junction
+/// cannot reach), a file a copy ([`mirrored`] keeps it up to date).
+#[cfg(windows)]
+fn link(src: &Path, dst: &Path) -> std::io::Result<()> {
+    if src.is_dir() {
+        junction::create(src, dst).or_else(|e| std::os::windows::fs::symlink_dir(src, dst).map_err(|_| e))
+    } else {
+        copy_mirror(src, dst)
+    }
+}
+
+/// Removes a link (Windows: a junction is a directory).
+fn remove_link(path: &Path) -> std::io::Result<()> {
+    fs::remove_file(path).or_else(|e| fs::remove_dir(path).map_err(|_| e))
+}
+
+/// `dst` is the copy of the game file `src` (Windows), refreshed when `src` changed; false when
+/// `dst` is not such a copy (a file the game made).
+#[cfg(windows)]
+fn mirrored(src: &Path, dst: &Path) -> std::io::Result<bool> {
+    let (Ok(s), Ok(d)) = (fs::metadata(src), fs::symlink_metadata(dst)) else { return Ok(false) };
+    if !s.is_file() || !d.is_file() {
+        return Ok(false);
+    }
+    if s.len() != d.len() || s.modified().ok() != d.modified().ok() {
+        copy_mirror(src, dst)?;
+    }
+    Ok(true)
+}
+
+#[cfg(unix)]
+fn mirrored(_src: &Path, _dst: &Path) -> std::io::Result<bool> {
+    Ok(false)
+}
+
+/// A copy of `src` with its modification time (what [`mirrored`] compares).
+#[cfg(windows)]
+fn copy_mirror(src: &Path, dst: &Path) -> std::io::Result<()> {
+    fs::copy(src, dst)?;
+    let modified = fs::metadata(src)?.modified()?;
+    fs::File::options().write(true).open(dst)?.set_modified(modified)
+}
