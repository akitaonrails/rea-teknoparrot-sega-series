new file mode 100644
index 0000000..d68f766
--- /dev/null
+++ b/crates/payload-segashell/src/inpwrapper.rs
@@ -0,0 +1,118 @@
+//! The Shell's `InpWrapper.exe` (`WAL_SEGASHELL_INPWRAPPER=1`): Daytona Championship USA's
+//! force feedback board on the parallel port, through a 64-bit helper (`inpoutx64.dll`).
+//!
+//! The game starts `c:\sega\shell\InpWrapper.exe -h=<game window> -p=<port>` (`0x5283e0`, the
+//! port from `../shell/Game.ini` `[Configuration] ParallelPort`, 888); the helper sends its own
+//! window to the game's (`WM_COPYDATA`, `dwData` 3, the handle: `0x4dc9d0`), then the game sends
+//! it each force byte (`SendMessageTimeoutA(helper, WM_COPYDATA)`, `dwData` 0x20, one byte;
+//! `0x528de0`), which it writes to the port. The answer (the message's result) 1 is done, 2 try
+//! again.
+//!
+//! Here the helper is not started: the payload answers its `CreateProcessA` and registers a
+//! made-up window with the game, and the game's sends to that window are taken: the byte goes to
+//! payload-common's `port_ffb` decoder (`WAL_SEGASHELL_FFB_FORMAT=daytona`).
+//!
+//! The byte (`0x528ef0`): 0 none, low nibble 1 (strongest) .. 15 (weakest), bit 0x10 clear for a
+//! force to the left (the wheel turned right: the centering spring), set to the right.
+
+use std::sync::atomic::{AtomicUsize, Ordering};
+
+use wal_payload_common::{iat, log};
+use windows_sys::Win32::Foundation::HWND;
+use windows_sys::Win32::System::DataExchange::COPYDATASTRUCT;
+use windows_sys::Win32::UI::WindowsAndMessaging::{SMTO_NORMAL, SendMessageTimeoutA, WM_COPYDATA};
+
+/// The made-up window of the helper.
+const HELPER: usize = 0x5741_4c01;
+
+type CreateProcessA = unsafe extern "system" fn(*const u8, *mut u8, usize, usize, i32, u32, usize, *const u8, usize, *mut ProcessInformation) -> i32;
+type SendMessageTimeout = unsafe extern "system" fn(usize, u32, usize, isize, u32, u32, *mut usize) -> isize;
+
+#[repr(C)]
+pub struct ProcessInformation {
+    process: usize,
+    thread: usize,
+    process_id: u32,
+    thread_id: u32,
+}
+
+static ORIG_CREATE: AtomicUsize = AtomicUsize::new(0);
+static ORIG_SEND: AtomicUsize = AtomicUsize::new(0);
+
+pub(crate) fn init() {
+    if let Some(o) = unsafe { iat::hook("kernel32.dll", "CreateProcessA", create_process as *const () as usize) } {
+        ORIG_CREATE.store(o, Ordering::Relaxed);
+    }
+    if let Some(o) = unsafe { iat::hook("user32.dll", "SendMessageTimeoutA", send_message_timeout as *const () as usize) } {
+        ORIG_SEND.store(o, Ordering::Relaxed);
+    }
+    log!("inpwrapper: the force feedback helper emulated");
+}
+
+fn c_str(p: *const u8) -> String {
+    if p.is_null() { String::new() } else { unsafe { std::ffi::CStr::from_ptr(p.cast()) }.to_string_lossy().into_owned() }
+}
+
+/// `-h=<hex>`: the game's window.
+fn game_window(command_line: &str) -> Option<usize> {
+    let h = command_line.split_whitespace().find_map(|w| w.strip_prefix("-h="))?;
+    usize::from_str_radix(h, 16).ok()
+}
+
+unsafe extern "system" fn create_process(
+    app: *const u8,
+    command_line: *mut u8,
+    process_attributes: usize,
+    thread_attributes: usize,
+    inherit: i32,
+    flags: u32,
+    environment: usize,
+    directory: *const u8,
+    startup: usize,
+    info: *mut ProcessInformation,
+) -> i32 {
+    let (name, args) = (c_str(app), c_str(command_line));
+    if name.to_ascii_lowercase().ends_with("inpwrapper.exe") {
+        log!("inpwrapper: {name} {args}: emulated");
+        if let Some(window) = game_window(&args) {
+            // the helper's registration, from another thread (the game's window thread is
+            // the caller)
+            std::thread::spawn(move || register(window));
+        }
+        if !info.is_null() {
+            // handles the game closes: none
+            unsafe { info.write(ProcessInformation { process: 0, thread: 0, process_id: 0, thread_id: 0 }) };
+        }
+        return 1;
+    }
+    let f: CreateProcessA = unsafe { std::mem::transmute(ORIG_CREATE.load(Ordering::Relaxed)) };
+    unsafe { f(app, command_line, process_attributes, thread_attributes, inherit, flags, environment, directory, startup, info) }
+}
+
+/// The helper's window sent to the game's (`WM_COPYDATA`, `dwData` 3).
+fn register(window: usize) {
+    std::thread::sleep(std::time::Duration::from_millis(500));
+    let handle: u32 = HELPER as u32;
+    let data = COPYDATASTRUCT { dwData: 3, cbData: 4, lpData: &handle as *const u32 as *mut _ };
+    let mut result = 0usize;
+    let ok = unsafe { SendMessageTimeoutA(window as HWND, WM_COPYDATA, 0, &data as *const _ as isize, SMTO_NORMAL, 5000, &mut result) };
+    log!("inpwrapper: registered with the game's window {window:#x}: {ok}");
+}
+
+unsafe extern "system" fn send_message_timeout(window: usize, msg: u32, wparam: usize, lparam: isize, flags: u32, timeout: u32, result: *mut usize) -> isize {
+    if window == HELPER {
+        if msg == WM_COPYDATA && lparam != 0 {
+            let data = unsafe { &*(lparam as *const COPYDATASTRUCT) };
+            if data.dwData == 0x20 && data.cbData >= 1 && !data.lpData.is_null() {
+                let byte = unsafe { *(data.lpData as *const u8) };
+                wal_payload_common::port_ffb::out("WAL_SEGASHELL", 0x378, byte as u16);
+            }
+        }
+        if !result.is_null() {
+            unsafe { *result = 1 };
+        }
+        return 1;
+    }
+    let f: SendMessageTimeout = unsafe { std::mem::transmute(ORIG_SEND.load(Ordering::Relaxed)) };
+    unsafe { f(window, msg, wparam, lparam, flags, timeout, result) }
+}
