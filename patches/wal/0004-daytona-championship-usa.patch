@@ -0,0 +1,82 @@
+# Daytona Championship USA (Sega Amusements, 2017; New Season Edition, 2019), racing game with a
+# wheel, pedals, a 4-speed H shifter and four view buttons on a Windows PC run by Sega's Shell:
+# Sega/Daytona/Daytona.exe (Direct3D 11); the payload plays the Shell and the I/O board.
+# Override values in userprofiles/segashell/daytona-championship-usa.yaml.
+system: segashell
+name: Daytona Championship USA
+
+input:
+  stick_as_dpad: false
+  gamepad:
+    r1: b1
+    l1: b2
+    dpup: up
+    dpdown: down
+    dpleft: left
+    dpright: right
+    r2: accel
+    l2: brake
+  keyboard_ramp_ms: 500
+  keyboard:
+    p1:
+      KEY_LEFT: -lx
+      KEY_RIGHT: lx
+      KEY_UP: accel
+      KEY_DOWN: brake
+
+env:
+  # the Shell's protocol of this game (DYT packets, the cabinet's configuration on launch)
+  WAL_SEGASHELL_PROTOCOL: dyt
+  # no Shell security challenges: unanswered, the game quits after 5 (the counter's check
+  # at 0x584d0f always passes)
+  WAL_PATCHES: "0x184d0f:EB"
+  # free play (over ShellData.ini): off, a coin per game
+  WAL_SEGASHELL_FREEPLAY: "0"
+  # the cabinet's board, a DirectInput game controller "SEGA IO Controller" (its buttons'
+  # functions from the game's table at 0x116d810): X the wheel, Z the brake, Rx the gas, axes
+  # -1000..1000; buttons 0 start (function 2), 1 / 2 / 6 / 7 functions 7-10, 3 / 4 functions
+  # 14 / 13, 8-11 functions 3-6 (read as the view buttons, shift and gears 1-4: start, wheel
+  # and pedals verified in races, the others not yet: no camera change seen, races in AT)
+  WAL_DINPUT_WHEEL: SEGA IO Controller
+  WAL_DINPUT_WHEEL_Z_AXIS: brake
+  WAL_DINPUT_WHEEL_RX_AXIS: accel
+  WAL_DINPUT_WHEEL_BUTTONS: "start,up,down,b1,b2,none,left,right,b3,b4,b5,b6"
+  WAL_DINPUT_WHEEL_FFB: "0"
+  # force feedback: the Shell's InpWrapper.exe (the parallel port board) emulated
+  WAL_SEGASHELL_INPWRAPPER: "1"
+  WAL_SEGASHELL_FFB_FORMAT: daytona
+  WAL_SEGASHELL_FFB: "100"
+
+options:
