+    /// A PE32 image laid out as Initial D 8's dump: its import thunks at the start of `.rdata`
+    /// (0x1000, two arrays), the import descriptors in a section of their own (`.mackt`,
+    /// 0x2000), the IAT data directory `iat` (empty in the dump). File offsets = RVAs.
+    fn dumped_pe32(iat: (u32, u32)) -> Vec<u8> {
+        let mut d = vec![0u8; 0x3000];
+        let put = |d: &mut Vec<u8>, at: usize, v: u32| d[at..at + 4].copy_from_slice(&v.to_le_bytes());
+        d[0..2].copy_from_slice(b"MZ");
+        put(&mut d, 0x3C, 0x80);
+        d[0x80..0x84].copy_from_slice(b"PE\0\0");
+        d[0x84..0x86].copy_from_slice(&0x14Cu16.to_le_bytes());
+        d[0x86..0x88].copy_from_slice(&2u16.to_le_bytes()); // sections
+        d[0x94..0x96].copy_from_slice(&0xE0u16.to_le_bytes()); // optional header size
+        let opt = 0x98;
+        d[opt..opt + 2].copy_from_slice(&0x10Bu16.to_le_bytes());
+        put(&mut d, opt + 92, 16); // NumberOfRvaAndSizes
+        put(&mut d, opt + 96 + 8, 0x2000); // import directory
+        put(&mut d, opt + 96 + 12, 60);
+        put(&mut d, opt + 96 + 96, iat.0);
+        put(&mut d, opt + 96 + 100, iat.1);
+        let sections = opt + 0xE0;
+        let layout = [(b".rdata\0\0", 0x1000u32, 0xC000_0040u32), (b".mackt\0\0", 0x2000, 0xE000_0060)];
+        for (i, (name, va, flags)) in layout.into_iter().enumerate() {
+            let s = sections + 40 * i;
+            d[s..s + 8].copy_from_slice(name);
+            put(&mut d, s + 8, 0x1000);
+            put(&mut d, s + 12, va);
+            put(&mut d, s + 16, 0x1000);
+            put(&mut d, s + 20, va);
+            put(&mut d, s + 36, flags);
+        }
+        // a.dll: 2 functions, thunks at 0x1000; b.dll: 1 function, thunks at 0x1010
+        for (i, (thunks, n, name)) in [(0x1000u32, 2u32, 0x2100u32), (0x1010, 1, 0x2110)].into_iter().enumerate() {
+            let at = 0x2000 + 20 * i;
+            put(&mut d, at, thunks); // OriginalFirstThunk (same names)
+            put(&mut d, at + 12, name);
+            put(&mut d, at + 16, thunks);
+            for k in 0..n {
+                put(&mut d, (thunks + 4 * k) as usize, 0x2200);
+            }
+        }
+        d[0x2100..0x2105].copy_from_slice(b"a.dll");
+        d[0x2110..0x2115].copy_from_slice(b"b.dll");
+        d
+    }
+
+    fn u32_at(d: &[u8], at: usize) -> u32 {
+        u32::from_le_bytes(d[at..at + 4].try_into().unwrap())
+    }
+
+    #[test]
+    fn readonly_section_holding_the_imports_gets_an_iat_directory() {
+        let t = tmp("iat");
+        let (src, dst) = (t.join("game.exe"), t.join("run.exe"));
+        fs::write(&src, dumped_pe32((0, 0))).unwrap();
+        readonly_sections(&src, &dst, &[".rdata".to_string()]).unwrap();
+        let d = fs::read(&dst).unwrap();
+        // .rdata read-only, .mackt untouched
+        assert_eq!(u32_at(&d, 0x98 + 0xE0 + 36), 0x4000_0040);
+        assert_eq!(u32_at(&d, 0x98 + 0xE0 + 40 + 36), 0xE000_0060);
+        // the IAT directory: both thunk arrays, null terminators included (0x1000..0x1018)
+        assert_eq!((u32_at(&d, 0x98 + 96 + 96), u32_at(&d, 0x98 + 96 + 100)), (0x1000, 0x18));
+        fs::remove_dir_all(&t).unwrap();
+    }
+
+    #[test]
+    fn declared_iat_directory_kept() {
+        let t = tmp("iat-kept");
+        let (src, dst) = (t.join("game.exe"), t.join("run.exe"));
+        fs::write(&src, dumped_pe32((0x1000, 0x8))).unwrap();
+        readonly_sections(&src, &dst, &[".rdata".to_string()]).unwrap();
+        let d = fs::read(&dst).unwrap();
+        assert_eq!((u32_at(&d, 0x98 + 96 + 96), u32_at(&d, 0x98 + 96 + 100)), (0x1000, 0x8));
+        fs::remove_dir_all(&t).unwrap();
+    }
+
+    #[test]
+    fn imports_outside_the_readonly_sections_left_alone() {
+        let t = tmp("iat-other");
+        let (src, dst) = (t.join("game.exe"), t.join("run.exe"));
+        fs::write(&src, dumped_pe32((0, 0))).unwrap();
+        readonly_sections(&src, &dst, &[".mackt".to_string()]).unwrap();
+        let d = fs::read(&dst).unwrap();
+        assert_eq!((u32_at(&d, 0x98 + 96 + 96), u32_at(&d, 0x98 + 96 + 100)), (0, 0));
+        fs::remove_dir_all(&t).unwrap();
+    }
 }
 
