+/// Sets the IAT data directory of the PE image `data` (PE header at `pe`) to the span of the
+/// import thunk arrays (their null entries included) that lie in the `readonly` RVA ranges,
+/// when the image declares none. Returns the directory set; `None` when it already had one,
+/// has no imports there, or its headers are not readable.
+fn declare_iat(data: &mut [u8], pe: usize, readonly: &[(u32, u32)]) -> Option<(u32, u32)> {
+    let u16_at = |d: &[u8], at: usize| d.get(at..at + 2).map(|b| u16::from_le_bytes(b.try_into().unwrap()));
+    let u32_at = |d: &[u8], at: usize| d.get(at..at + 4).map(|b| u32::from_le_bytes(b.try_into().unwrap()));
+    let optional = pe + 24;
+    let (thunk, directories) = match u16_at(data, optional)? {
+        0x10B => (4usize, optional + 96),
+        0x20B => (8, optional + 112),
+        _ => return None,
+    };
+    // NumberOfRvaAndSizes (the field just before the directories) must reach entry 12 (IAT)
+    if u32_at(data, directories - 4)? < 13 || u32_at(data, directories + 96)? != 0 || u32_at(data, directories + 100)? != 0 {
+        return None;
+    }
+    let count = u16_at(data, pe + 6)? as usize;
+    let table = optional + u16_at(data, pe + 20)? as usize;
+    let file_offset = |d: &[u8], rva: u32| -> Option<usize> {
+        (0..count).find_map(|i| {
+            let s = table + 40 * i;
+            let (va, vsize, raw_size, raw) = (u32_at(d, s + 12)?, u32_at(d, s + 8)?, u32_at(d, s + 16)?, u32_at(d, s + 20)?);
+            (rva >= va && rva - va < vsize.max(raw_size)).then(|| (raw + (rva - va)) as usize)
+        })
+    };
+    let mut descriptor = file_offset(data, u32_at(data, directories + 8)?)?;
+    let (mut start, mut end) = (u32::MAX, 0u32);
+    // IMAGE_IMPORT_DESCRIPTOR: 20 bytes, Name at +12, FirstThunk at +16; a zero Name ends them
+    while u32_at(data, descriptor + 12).is_some_and(|name| name != 0) {
+        let first = u32_at(data, descriptor + 16)?;
+        if readonly.iter().any(|&(lo, hi)| first >= lo && first < hi) {
+            let mut at = file_offset(data, first)?;
+            let mut rva = first;
+            while data.get(at..at + thunk)?.iter().any(|&b| b != 0) {
+                at += thunk;
+                rva += thunk as u32;
+            }
+            start = start.min(first);
+            end = end.max(rva + thunk as u32);
+        }
+        descriptor += 20;
+    }
+    if start >= end {
+        return None;
+    }
+    data[directories + 96..directories + 100].copy_from_slice(&start.to_le_bytes());
+    data[directories + 100..directories + 104].copy_from_slice(&(end - start).to_le_bytes());
+    Some((start, end - start))
+}
